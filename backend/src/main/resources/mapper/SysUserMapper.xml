<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eduforge.training.mapper.SysUserMapper">

    <sql id="userColumns">
        id, username, password, name, gender, phone, email, avatar, status, create_time, update_time
    </sql>

    <select id="findAll" resultType="com.eduforge.training.pojo.SysUser">
        SELECT <include refid="userColumns"/> FROM sys_user ORDER BY id
    </select>

    <select id="findById" resultType="com.eduforge.training.pojo.SysUser">
        SELECT <include refid="userColumns"/> FROM sys_user WHERE id = #{id}
    </select>

    <select id="findByUsername" resultType="com.eduforge.training.pojo.SysUser">
        SELECT <include refid="userColumns"/> FROM sys_user WHERE username = #{username}
    </select>

    <update id="updateById">
        UPDATE sys_user
        SET password = #{password}, update_time = #{updateTime}
        WHERE id = #{id}
    </update>
</mapper>
